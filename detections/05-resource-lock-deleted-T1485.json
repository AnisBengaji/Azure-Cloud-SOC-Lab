{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "name": "law-cloudsoc/Microsoft.SecurityInsights/resource-lock-deleted-t1485",
      "apiVersion": "2023-02-01",
      "kind": "Scheduled",
      "properties": {
        "displayName": "Resource Lock Deleted - Impact (T1485)",
        "description": "Detects deletion of an Azure resource lock, which removes protection against destructive actions and often precedes resource tampering or deletion.",
        "severity": "Medium",
        "enabled": true,
        "query": "AzureActivity | where OperationNameValue has 'LOCKS/DELETE' | where ActivityStatusValue == 'Success' | project TimeGenerated, Caller, CallerIpAddress, Resource, ResourceGroup, OperationNameValue",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT1H",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "tactics": ["Impact"],
        "techniques": ["T1485"],
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT1H",
            "matchingMethod": "AllEntities"
          }
        },
        "entityMappings": [
          { "entityType": "Account", "fieldMappings": [{ "identifier": "Name", "columnName": "Caller" }] },
          { "entityType": "IP", "fieldMappings": [{ "identifier": "Address", "columnName": "CallerIpAddress" }] }
        ]
      }
    }
  ]
}
